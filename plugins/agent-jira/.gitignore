# Plugin-scoped .gitignore (activates on standalone extraction).

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# Distribution / packaging
build/
dist/
wheels/
*.egg-info/
*.egg
pip-wheel-metadata/

# Virtualenvs
.venv/
venv/
env/
.env
.env.*
!.env.example

# Runtime state
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
logs/
*.log

# Vite UI — source under ui/, build output served from app/static/frontend/.
# NB: the bundled UI is committed on purpose (deployments fetch it via the
# static mount). Source-only ignores live here; the asset dir is NOT excluded.
ui/node_modules/
ui/dist/
ui/.vite/
ui/tsconfig.tsbuildinfo
ui/*.tsbuildinfo
ui/playwright-report/
ui/test-results/
ui/.playwright/

# Tooling caches
.eslintcache
.DS_Store
.vscode/
.idea/
