# =============================================================================
# agent-jira — env template (stack-aligned con baselithcore-enterprise root)
# =============================================================================
#
# Copia in `.env` (mai committare):
#   cp plugins/agent-jira/.env.example plugins/agent-jira/.env
#
# Setup DB locale (riusa container `postgres_db` del root docker-compose —
# stessa istanza condivisa fra tutti i plugin, suddivisione logica per DB):
#
#   docker compose up -d postgres qdrant redis
#   docker exec postgres_db psql -U baselithcore -d baselithcore \
#     -c "CREATE USER agent_jira WITH PASSWORD 'agent_jira_dev';" \
#     -c "CREATE DATABASE agent_jira OWNER agent_jira;"
#   cd plugins/agent-jira && alembic upgrade head
#
# =============================================================================
# CORE / SERVER
# =============================================================================
HOST=0.0.0.0
PORT=8181
LOG_LEVEL_CONSOLE=INFO
LOG_FORMAT=text                       # text | json

# =============================================================================
# AUTH / JWT
# =============================================================================
# REQUIRED. Genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
MULTI_TENANT_ENABLED=true
AUTH_COOKIE_SECURE=false              # false per dev http://localhost
AUTH_COOKIE_SAMESITE=strict           # strict | lax | none

# =============================================================================
# POSTGRES — stack root (container `postgres_db`)
# =============================================================================
# DATABASE_URL ha precedenza assoluta. In alternativa singoli parametri.
DATABASE_URL=postgresql://agent_jira:agent_jira_dev@localhost:5432/agent_jira
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=agent_jira
# DB_USER=agent_jira
# DB_PASSWORD=agent_jira_dev
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT=10

POSTGRES_ENABLED=true

# =============================================================================
# QDRANT — stack root (container `baselith-core-qdrant`)
# =============================================================================
QDRANT_MODE=server                    # server (usa root) | embedded (dev isolato)
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=agent_jira_filesystem # collection logica dedicata al plugin

# =============================================================================
# FALKORDB / REDIS — stack root (container `baselith-core-redis`)
# =============================================================================
GRAPH_DB_ENABLED=true
GRAPH_DB_URL=redis://localhost:6379
GRAPH_DB_NAME=agent_jira_graph        # graph logico dedicato al plugin
GRAPH_DB_TIMEOUT=2

CACHE_BACKEND=redis                   # redis | memory
CACHE_REDIS_URL=redis://localhost:6379/1   # DB index 1 (root usa 0)
CACHE_REDIS_PREFIX=agent_jira:

# =============================================================================
# RATE LIMIT
# =============================================================================
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_ADMIN_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# LLM / EMBEDDER
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest
EMBEDDER_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# =============================================================================
# CHAT / INDEX
# =============================================================================
CHAT_INITIAL_SEARCH_K=50
CHAT_FINAL_TOP_K=5
INDEX_BOOTSTRAP_ENABLED=true
INDEX_EMBED_BATCH_SIZE=32

# =============================================================================
# JIRA INTEGRATION (opzionale)
# =============================================================================
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_USER_EMAIL=
# JIRA_API_TOKEN=
