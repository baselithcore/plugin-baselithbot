# Honeypot Plugin - AI-powered deception system
honeypot:
  enabled: true

  # Protocol Settings
  enable_ssh_honeypot: true
  enable_http_honeypot: true
  enable_tcp_honeypot: true
  enable_mcp_honeypot: true
  ssh_port: 2222
  http_port: 8080
  tcp_ports: [2121, 2323, 6380] # FTP, Telnet, Redis

  # HTTP Emulation
  http_emulated_app: 'wordpress' # wordpress, phpmyadmin, jenkins
  http_server_header: 'Apache/2.4.53 (Debian)'

  # LLM Integration (for realistic responses)
  enable_llm_responses: true
  llm_provider: 'ollama'
  llm_model: 'llama3.2'
  ollama_base_url: 'http://localhost:11434'
  # openai_api_key: "${OPENAI_API_KEY}" # Only if provider is openai

  # HoneyDOC Sensibility (Traffic Classification)
  enable_sensibility: true
  default_flow_action: 'forward' # drop, forward, redirect
  classification_rules:
    - sid: 'honeydoc-001'
      protocol: 'any'
      action: 'redirect'
      content: '(rm\s+-rf|chmod\s+777|nc\s+-e)'
      priority: 100
      description: 'Critical command injection - redirect to HIH'

  # HoneyDOC Stealth & Flow Control
  enable_stealth: true
  enable_flow_control: true
  consistent_fingerprint: true
  stealth_response_delay_ms: 100
  mask_python_headers: true
  auto_block_threshold: 10

  # Webhook Notifications
  enable_notifications: true
  notification_min_severity: "high"
  notification_cooldown_seconds: 30
  telegram_bot_token: ""
  telegram_chat_id: ""
  discord_webhook_url: ""
  notification_ignore_credentials:
    - "admin:password"
    - "admin:123456"
  notification_ignore_categories:
    - "credential_harvesting"

  # Webhook Notifications
  enable_notifications: true
  notification_min_severity: "high"
  notification_cooldown_seconds: 30
  telegram_bot_token: ""
  telegram_chat_id: ""
  discord_webhook_url: ""
  notification_ignore_credentials:
    - "admin:password"
    - "admin:123456"
  notification_ignore_categories:
    - "credential_harvesting"

  # Integration with CVE Hunter
  enable_cve_correlation: true
  correlation_confidence_threshold: 0.6

  # Security Limits
  max_concurrent_sessions: 50
  rate_limit_connections_per_ip: 10
  banned_ip_timeout_minutes: 60
