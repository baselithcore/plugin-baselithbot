# =============================================================================
# LLM-Enhanced Report Generation Configuration
# =============================================================================
# Copy these settings to your main .env file to enable AI-powered reports
# =============================================================================

# -------------------------
# LLM Provider Selection
# -------------------------
# Choose: ollama (local) or openai (cloud)
LLM_PROVIDER=ollama

# -------------------------
# Ollama Configuration (Local/Free)
# -------------------------
# Install: https://ollama.ai
# Start: ollama serve
# Pull model: ollama pull llama3.2

LLM_MODEL=llama3.2:latest
LLM_API_BASE=http://localhost:11434

# Recommended Ollama Models for Security Reports:
# - llama3.2:latest (4GB VRAM) - Fast, good quality
# - mixtral:8x7b (26GB VRAM) - Highest quality, slower
# - codellama:34b (19GB VRAM) - Technical focus
# - mistral:latest (4GB VRAM) - Balanced alternative

# -------------------------
# OpenAI Configuration (Cloud/Paid)
# -------------------------
# Get API key: https://platform.openai.com/api-keys
# Uncomment these lines and comment out Ollama settings above

# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4-turbo-preview
# LLM_API_KEY=sk-your-openai-api-key-here

# Recommended OpenAI Models:
# - gpt-4-turbo-preview - Best quality ($0.01/1K tokens)
# - gpt-4 - High quality ($0.03/1K tokens)
# - gpt-3.5-turbo - Fast & cheap ($0.0015/1K tokens)

# -------------------------
# LLM Generation Settings
# -------------------------
# Temperature: 0.0 = deterministic, 1.0 = creative, 2.0 = very creative
# For security reports: 0.5-0.8 recommended
LLM_TEMPERATURE=0.7

# Max tokens per response (optional, provider-specific)
# LLM_MAX_TOKENS=2000

# -------------------------
# Caching Configuration
# -------------------------
# Cache LLM responses to reduce API calls and improve speed
LLM_ENABLE_CACHE=true

# Cache TTL in seconds (3600 = 1 hour)
LLM_CACHE_TTL=3600

# Max cached items
LLM_CACHE_MAX_SIZE=1000

# -------------------------
# Report Service Settings
# -------------------------
# Enable/disable LLM for all reports (can override per request)
HONEYPOT_REPORTS_USE_LLM=true

# Fallback to templates if LLM fails
HONEYPOT_REPORTS_LLM_FALLBACK=true

# -------------------------
# Cost Control (OpenAI only)
# -------------------------
# Uncomment to set daily spending limits
# LLM_DAILY_BUDGET_USD=10.00

# -------------------------
# Performance Tuning
# -------------------------
# Timeout for LLM requests (seconds)
LLM_TIMEOUT=30

# Retry attempts on failure
LLM_MAX_RETRIES=3

# -------------------------
# Example Configurations
# -------------------------

# DEVELOPMENT (Free, Local):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2:latest
# LLM_API_BASE=http://localhost:11434
# LLM_TEMPERATURE=0.7

# PRODUCTION (High Quality):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4-turbo-preview
# LLM_API_KEY=sk-...
# LLM_TEMPERATURE=0.6

# PRODUCTION (Cost-Optimized):
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-3.5-turbo
# LLM_API_KEY=sk-...
# LLM_TEMPERATURE=0.7
