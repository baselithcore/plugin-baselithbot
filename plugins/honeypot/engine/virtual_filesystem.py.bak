        )

        # Old config file backup (common pattern)
        self._create_file(
            f"{home}/.bashrc.bak",
            "# old bashrc backup from migration\n",
            permissions="rw-r--r--",
        )

        # Downloads with some "forgotten" files
        self._create_file(
