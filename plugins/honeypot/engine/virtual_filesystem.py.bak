# Jumplist (newest first):
-'  1  0  ~/.bashrc
-'  15  0  /etc/nginx/nginx.conf
""",
            permissions="rw-------",
        )

        # Lesshst - less command history
        self._create_file(
            f"{home}/.lesshst",
            """.less-history-file:
.search
"error"
"warning"
"fail"
""",
            permissions="rw-------",
        )

        # Some scripts in home
        self._create_file(
