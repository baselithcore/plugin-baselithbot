# Dev image for the Red Agent endpoint daemon.
#
# Multi-stage build:
#   1. `builder` stage compiles the workspace (release profile).
#   2. `runtime` stage ships the static binary on a debian-slim base.
#
# Production builds will replace `debian:slim` with `gcr.io/distroless/cc`
# once the CI matrix verifies the daemon links cleanly under musl.

FROM rust:1.88-slim-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
        protobuf-compiler \
        libprotobuf-dev \
        pkg-config \
        libssl-dev \
        ca-certificates \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# Compose sets `context: ../..` (plugins/red_agent), so /src holds both
# the Rust workspace under daemon/ and the language-neutral proto file
# under proto/agent.proto. The workspace's `crates/proto/build.rs`
# resolves the latter via the relative `../../../proto/agent.proto`
# fallback baked in at locate_proto().
COPY . .

# Build the binary in release mode. We point cargo at the daemon
# workspace explicitly because the build context root has no
# Cargo.toml (the monorepo's Python layout sits alongside).
RUN cargo build --manifest-path daemon/Cargo.toml --release \
        --bin baselith-redagent-daemon

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --uid 1100 --shell /usr/sbin/nologin baselith

COPY --from=builder /src/daemon/target/release/baselith-redagent-daemon /usr/local/bin/baselith-redagent-daemon

USER baselith
WORKDIR /var/lib/baselith

# Default command runs the daemon in `run` mode. Operators issue
# `baselith-redagent-daemon enroll --token ...` once before the first
# start; subsequent boots load the persisted identity from the
# keystore.
ENTRYPOINT ["/usr/local/bin/baselith-redagent-daemon"]
CMD []
