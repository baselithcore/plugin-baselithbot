{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docheck.local/schemas/finding.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id","severity","rule_id","policy_ref","evidence","explanation","confidence","reasoning"],
  "properties": {
    "id":          { "type": "string" },
    "severity":    { "enum": ["FAIL","WARN","PASS","INFO"] },
    "rule_id":     { "type": "string" },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","policy_id","version","title","excerpt"],
      "properties": {
        "id":        { "type": "string" },
        "policy_id": { "type": "string" },
        "version":   { "type": "string" },
        "title":     { "type": "string" },
        "excerpt":   { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chunk_id","page","line_start","line_end","bbox","text"],
      "properties": {
        "chunk_id":   { "type": "string" },
        "page":       { "type": "integer" },
        "line_start": { "type": "integer" },
        "line_end":   { "type": "integer" },
        "bbox": {
          "type": "array",
          "minItems": 4, "maxItems": 4,
          "items": { "type": "number" }
        },
        "text":       { "type": "string" }
      }
    },
    "explanation": { "type": "string" },
    "suggestion":  { "type": ["string","null"] },
    "confidence":  { "type": "number", "minimum": 0, "maximum": 1 },
    "reasoning": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step","agent"],
        "properties": {
          "step":   { "type": "integer" },
          "agent":  { "type": "string" },
          "action": { "type": ["string","null"] },
          "input":  { "type": ["object","null"] },
          "output": { "type": ["object","null"] },
          "thought":{ "type": ["string","null"] }
        }
      }
    }
  }
}
