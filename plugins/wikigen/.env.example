# .env.example — White-label LLM Wiki Engine
# Copia in .env e personalizza. Tutte le env vars sono opzionali tranne
# dove indicato (REQUIRED in produzione). Il wizard scaffold (`wiki-wl init`
# o UI Setup Wizard) popola APP_DOMAIN + WIKI_ROOT automaticamente.
#
# NB: scaffold/activate scrive .env con perm 0600 (engine hardening).
# Mantieni la stessa perm se editi il file a mano: `chmod 0600 .env`.

# =============================================================================
# WHITE-LABEL DOMAIN SELECTOR
# =============================================================================
# Pack vertical attivo (insurance|legal|medical|technical|<custom>). Vuoto =
# setup mode: solo admin endpoints raggiungibili per il wizard.
APP_DOMAIN=

# Override path on-disk del Domain Pack. Default: <repo>/domains/<APP_DOMAIN>/
# DOMAIN_PACK_DIR=

# =============================================================================
# VAULT (filesystem wiki)
# =============================================================================
# Path canonico del vault SHARED. Wizard lo scrive automaticamente.
# WIKI_ROOT=/path/to/vault

WIKI_DIR=wiki
RAW_DIR=raw

# =============================================================================
# LLM PROVIDER
# =============================================================================
LLM_VENDOR=ollama                    # ollama | openai

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# OLLAMA_EMBED_MODEL=bge-m3          # opzionale: embedder via Ollama

# --- OpenAI / OpenAI-compatible ---
# OPENAI_API_KEY=sk-...
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Modelli dedicati per fase ---
INGEST_OLLAMA_MODEL=llama3.2:latest  # 3B per classify/plan/generate (3-5x più veloce)
# INGEST_OPENAI_MODEL=               # default = OPENAI_MODEL
# SYNTHESIS_MODEL=qwen2.5:7b-instruct  # scaffold-time prompt synth (capacità ↑)

# --- LLM tuning ---
LLM_TIMEOUT=600
LLM_KEEP_ALIVE=30m                   # Ollama: tempo modello in RAM (0/30m/-1m)
INGEST_MAX_CONCURRENT=1              # Ollama serializza: tieni 1 senza multi-GPU
INGEST_LOOSE_JSON=                   # vuoto = auto (true ollama, false openai)
INGEST_OLLAMA_NUM_CTX=8192           # 0 = default Ollama (2048, sconsigliato)
INGEST_SKIP_DOCLING_THRESHOLD=800    # 0 = sempre docling
INGEST_BATCH_CLASSIFY_PLAN=true
INGEST_CRITIC_MAX_ITER=1

# =============================================================================
# EMBEDDINGS
# =============================================================================
EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDER_FORCE_LEGACY=false
EMBEDDER_DEVICE=auto                 # auto | cuda | mps | cpu
EMBEDDER_BATCH_SIZE=32
EMBEDDER_USE_FP16=true
# EMBEDDER_URL=http://embedder:8080  # remote embedder (opzionale)
EMBEDDER_HTTP_TIMEOUT=120
OFFLINE_MODE=false

# =============================================================================
# VECTOR STORE (Qdrant)
# =============================================================================
QDRANT_MODE=embedded                 # embedded | server
QDRANT_PATH=./qdrant_data            # solo embedded
QDRANT_URL=http://localhost:6333     # solo server
# QDRANT_API_KEY=
# COLLECTION_NAME=                   # default: <APP_DOMAIN>-wiki
QDRANT_TIMEOUT=60
QDRANT_PREFER_GRPC=false             # true = obbligatorio con ColBERT attivo
QDRANT_GRPC_PORT=6334
# QDRANT_UPSERT_BATCH_SIZE=          # default dinamico per modalità ColBERT

# =============================================================================
# HYBRID RETRIEVAL (dense + sparse + ColBERT)
# =============================================================================
HYBRID_ENABLED=true
HYBRID_USE_COLBERT=true
HYBRID_PREFETCH_LIMIT=50

# =============================================================================
# CROSS-ENCODER RERANKER
# =============================================================================
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_INPUT_MULT=5                # candidati = top_k * mult
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=32

# =============================================================================
# MMR — DIVERSITÀ POST-RERANK
# =============================================================================
# Maximal Marginal Relevance: evita top-K omogenei (chunk dello stesso
# vicinato semantico). Costa 1 batch embedder sui candidati post-rerank.
MMR_ENABLED=true
MMR_LAMBDA=0.7                       # 1.0 = relevance pura, 0.0 = diversità pura

# =============================================================================
# CITATION VALIDATION (post-generation grounding)
# =============================================================================
# Estrae [[folder/slug]] dalla risposta e verifica:
# - folder ∈ pack.page_types[*].folder
# - slug ∈ document_id recuperati (se strict)
CITATION_VALIDATION_ENABLED=true
CITATION_STRICT_GROUNDING=true       # bar alto: solo slug delle fonti recuperate
CITATION_REPAIR_ENABLED=false        # ON = LLM call extra per ricomporre

# =============================================================================
# RAG SAMPLING — faithfulness sopra creatività
# =============================================================================
# Temperatura per la generazione RAG. Bassa = più fedele al CONTESTO.
# 0.0 deterministic (greedy), 0.1 default, oltre 0.4 il modello inizia a
# riempire i gap del contesto con knowledge parametrica (hallucination).
RAG_TEMPERATURE=0.1
RAG_TOP_P=0.9                        # nucleus sampling, lavora in tandem con temp
RAG_NUM_PREDICT=-1                   # cap max-token risposta. -1 = nessun cap
RAG_SEED=0                           # >0 = seed deterministico (test/A-B)
# Intent guard: rileva mismatch query operativa ↔ contesto concettuale.
# Quando attivo, prepend di uno "scope warning" al CONTESTO che il modello
# echeggia come premessa onesta della risposta. Difesa di prima linea
# contro hallucination procedurali su corpora concettuali. Default ON.
RAG_INTENT_GUARD_ENABLED=true
# Groundedness scorer (LLM-as-judge). Dopo generate, un secondo LLM call
# valuta ogni claim della risposta contro il CONTESTO. Sotto soglia →
# warning event (stream) o rigenerazione (answer + RAG_GROUNDEDNESS_REPAIR=true).
# COSTOSO: 1 LLM call extra. Default OFF. Abilita per deploy regolati.
RAG_GROUNDEDNESS_ENABLED=false
RAG_GROUNDEDNESS_MIN=0.95
RAG_GROUNDEDNESS_REPAIR=false        # ON = 2 LLM call totali quando below_threshold
RAG_GROUNDEDNESS_MODEL=              # vuoto = usa il modello RAG attivo
# Code-block guard: rileva blocchi di codice fabbricati (presenti nell'answer,
# assenti nel CONTESTO). Zero costo (regex). Default ON. STRIP=true rimuove
# materialmente i fence fabbricati dalla risposta finale (path answer).
RAG_CODE_BLOCK_GUARD_ENABLED=true
RAG_CODE_BLOCK_STRIP=false
# Numeric-claim guard: cifre/percentuali/durate/dimensioni nella risposta che
# non compaiono nel CONTESTO sono flaggate come fabbricate. Zero costo (regex).
# Default ON. INCLUDE_GENERIC attiva anche i numeri standalone senza unit
# (default OFF: falsi positivi su anni / numerazione di sezioni). STRIP=true
# redige i token non supportati con `[dato non verificato]` (path answer).
RAG_NUMERIC_GUARD_ENABLED=true
RAG_NUMERIC_GUARD_INCLUDE_GENERIC=false
RAG_NUMERIC_STRIP=false

# =============================================================================
# QUERY UNDERSTANDING — HyDE + DECOMPOSITION (OPZIONALI)
# =============================================================================
# HyDE: pseudo-doc che ipoteticamente risponde alla query, aggiunto al pool
# di embedding. +10-25% recall su query in registro divergente. Costa LLM call.
HYDE_ENABLED=false
HYDE_MAX_TOKENS=200

# Decomposition: scompone domande multi-slot in sub-query atomiche.
# Costa LLM call. Cap basso: blow-up = max_subs * (1 + variants).
QUERY_DECOMPOSITION_ENABLED=false
QUERY_DECOMPOSITION_MAX_SUBS=3

# =============================================================================
# CONTEXTUAL RETRIEVAL (Anthropic-style chunk contextualization)
# =============================================================================
CONTEXTUAL_ENABLED=false
CONTEXTUAL_LLM_MODEL=qwen2.5:7b-instruct
CONTEXTUAL_MAX_TOKENS=120
CONTEXTUAL_CONCURRENCY=6

# =============================================================================
# GRAPH (FalkorDB + algoritmi, opzionale — pip install ".[graph]")
# =============================================================================
# Knowledge graph layer ispirato a graphify. Tutti i flag default OFF:
# il sistema funziona senza grafo, RAG resta invariato. Vedi docs/graph.md.
#
# Avvio FalkorDB: docker compose --profile graph up -d

# --- FalkorDB connection (PR1) ----------------------------------------------
GRAPH_DB_ENABLED=false
GRAPH_DB_URL=redis://localhost:6379
# GRAPH_DB_NAME=                     # default: COLLECTION_NAME
GRAPH_DB_TIMEOUT=5.0

# --- Entity extraction (PR1) -----------------------------------------------
# Post-ingest: estrai entità + relazioni via LLM (1 call/pagina).
GRAPH_EXTRACT_ENABLED=false
# Vuoto = fallback INGEST_OLLAMA_MODEL (ollama) / INGEST_OPENAI_MODEL (openai).
GRAPH_EXTRACT_MODEL=

# --- RAG-aware expansion (PR1) ---------------------------------------------
# Rag_agent espande context via neighbor entità a k-hop. Senza grafo
# popolato = no-op silenzioso.
GRAPH_RAG_ENABLED=false
GRAPH_RAG_HOPS=1
GRAPH_RAG_MAX_EXTRA_PAGES=3
# Filtra MENTIONS / R sotto soglia in retrieval. 0.5 = tiene EXTRACTED +
# INFERRED, scarta AMBIGUOUS.
GRAPH_CONFIDENCE_MIN=0.5

# --- Algoritmi + report (PR2) ----------------------------------------------
# Resolution parameter Leiden RBConfiguration. Più alto = community più
# numerose/piccole. Richiede `python-igraph + leidenalg`; senza, fallback
# a weakly-connected components.
GRAPH_LEIDEN_RESOLUTION=1.0
# Damping factor PageRank (paper Brin & Page).
GRAPH_PAGERANK_ALPHA=0.85
# Cap default per /api/graph/centrality + report.
GRAPH_CENTRALITY_TOP_N=25
# Dove `wiki-wl graph report` scrive GRAPH_REPORT.md + graph.json.
# Default: WIKI_ROOT/.graphify
# GRAPH_REPORT_DIR=

# =============================================================================
# RETRIEVAL TUNING + CHUNKING
# =============================================================================
RETRIEVAL_TOP_K=8
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# =============================================================================
# CACHE TTL (in-process)
# =============================================================================
LLM_CACHE_TTL=3600
EMBEDDING_CACHE_TTL=86400

# =============================================================================
# FEEDBACK 👍/👎
# =============================================================================
FEEDBACK_ENABLED=true
# FEEDBACK_LOG_PATH=                 # default: $WIKI_ROOT/.feedback.jsonl

# =============================================================================
# POSTGRES + AUTH (Fase 1+ multi-tenant)
# =============================================================================
# Abilita pool psycopg3. Senza DATABASE_URL/POSTGRES_HOST l'app gira ma
# le rotte auth/conversations/memories/feedback ritornano 503.
POSTGRES_ENABLED=false
# DATABASE_URL=postgresql://user:pass@localhost:5432/llm_wiki
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=llm_wiki
# POSTGRES_USER=app_runtime          # USER non superuser → RLS FORCED si applica
# POSTGRES_PASSWORD=                 # CAMBIA in prod (default docker-compose è dev-only)
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT=30
APP_TIMEZONE=UTC

# --- JWT / Auth ---
# REQUIRED se AUTH_REQUIRED=true. Genera con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Mai committare in repo. File .env perm 0600.
# SECRET_KEY=
AUTH_REQUIRED=false
AUTH_PUBLIC_REGISTRATION=false
AUTH_COOKIE_SECURE=true              # false solo per dev su http://
AUTH_COOKIE_SAMESITE=strict          # strict | lax | none
ACCESS_TOKEN_TTL_MINUTES=1440
REFRESH_TOKEN_TTL_DAYS=30
MULTI_TENANT_REQUIRED=               # default = AUTH_REQUIRED

# --- Bootstrap admin (primo boot, users vuoto) ---
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_PASSWORD=          # vuoto = generata + stampata su stderr

# =============================================================================
# RATE LIMITING
# =============================================================================
# Backend Redis se CACHE_BACKEND=redis (raccomandato in produzione multi-worker).
# Con CACHE_BACKEND=memory ogni worker uvicorn ha la propria sliding-window —
# sufficiente per single-instance dev/staging.
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_ADMIN_PER_MINUTE=60
RATE_LIMIT_JOB_PER_MINUTE=30
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_BACKEND=memory                 # memory | redis
CACHE_REDIS_URL=redis://localhost:6380/0

# =============================================================================
# SECURITY HEADERS
# =============================================================================
SECURITY_HEADERS_ENABLED=true
ENABLE_HSTS=false                    # true SOLO dietro HTTPS (HSTS è sticky)
# CSP raccomandata in produzione. Esempio restrittivo (no inline script):
# CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# =============================================================================
# ADMIN / SCAFFOLD WIZARD
# =============================================================================
# Endpoint /api/admin/* (scaffold + tenant management). Scrive su domains/
# e .env, quindi il gate è critico.
#
# Strategia gate (engine hardening):
#
# - ADMIN_API_LOOPBACK_ONLY=true (default): solo client loopback
#   (127.0.0.1, ::1, ::ffff:127.0.0.1) raggiungono /api/admin/*. Il
#   middleware valida via `ipaddress.is_loopback` e RIFIUTA richieste
#   con header proxy (X-Forwarded-For / Forwarded / X-Real-IP /
#   X-Client-IP) — la presenza di questi header indica un proxy davanti
#   che potrebbe aver riscritto client.host.
#
# - Deploy dietro reverse-proxy (nginx/Caddy/Traefik): NON avviare
#   uvicorn con `--proxy-headers` o `--forwarded-allow-ips=*` se vuoi
#   mantenere ADMIN_API_LOOPBACK_ONLY=true. Alternativa raccomandata in
#   produzione: POSTGRES_ENABLED=true + AUTH_REQUIRED=true + bootstrap
#   admin → /api/admin/* richiede bearer JWT con role=admin (verificato
#   router-side via require_admin). In quella modalità il bearer è
#   l'auth primaria e il loopback gate resta defense-in-depth.
#
# - Accesso al wizard in prod: SSH+port-forward
#   (`ssh -L 8000:localhost:8000 host`) oppure reverse-proxy mTLS che
#   strippa header XFF in ingresso.
ADMIN_API_ENABLED=true
ADMIN_API_LOOPBACK_ONLY=true
AUTO_INGEST_ON_STARTUP=true

# =============================================================================
# OBSERVABILITY (logging, metrics, tracing)
# =============================================================================
# Logging strutturato. `json` quando deployato dietro Promtail/Loki:
# ogni log line è un JSON con campi timestamp/level/logger/message/
# request_id/tenant_id parsabili dagli aggregatori (Loki, ELK, Datadog).
# `text` (default) per dev locale: human-readable, una riga per record.
# LOG_FORMAT=text
# LOG_LEVEL_CONSOLE=INFO
# LOG_LEVEL_FILE=INFO

# Prometheus /metrics gating. Tre policy alternative (in OR):
#   1) X-API-Key header == WIKI_METRICS_TOKEN (recommended per scrape)
#   2) Authorization: Bearer <jwt admin> (richiede Postgres + auth)
#   3) Loopback (dev/setup, sempre permesso)
# Imposta WIKI_METRICS_TOKEN a un secret robusto e configuralo nel
# Prometheus scrape job (vedi deploy/observability/prometheus/prometheus.yml.tpl).
# WIKI_METRICS_TOKEN=

# OpenTelemetry tracing — OPT-IN. Senza endpoint l'init è no-op.
# Installa l'extra `[obs]`: pip install -e '.[obs]'
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=llm-wiki
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=prod,service.version=0.1.0


# =============================================================================
# FRONTEND (vite — namespace VITE_*)
# =============================================================================
# VITE_API_URL=http://localhost:8000  # override solo se backend diverso

# Frontend RUM via Grafana Faro (opzionale). Forwarda web-vitals,
# console errors, fetch spans direttamente all'OTEL collector (porta 4319).
# Richiede @grafana/faro-web-sdk + faro-web-tracing nel frontend.
# VITE_OTLP_ENDPOINT=http://localhost:4319
# VITE_APP_VERSION=0.1.0
# VITE_APP_ENV=dev
