"""Optional strategy hooks for this Domain Pack.

Rename to ``strategies.py`` to enable. The registry imports
``domains.<this-pack>.strategies`` lazily; if the file is absent the
engine falls back to :class:`DefaultPageTypeStrategy` for every page.

When to write a strategy
------------------------
- You want a different prompt per ``(page_type, subtype)`` and the
  default of ``<page_type>_page.j2`` isn't enough (e.g. the insurance
  pack has a dedicated *garanzia-assicurativa* renderer).
- You need to extract a specific section of the source PDF before
  feeding the LLM (heading hints, table filters, snippet windowing).
- You want to seed pack-specific frontmatter defaults — implement
  ``frontmatter_defaults(entry, plan) -> dict`` and the orchestrator
  will merge it on top of the base defaults.
"""

from __future__ import annotations

from typing import Any

from llm_wiki.domain.strategies import GenerationContext, PageTypeStrategy


class ExampleSourceStrategy:
    """Skeleton: render a 'source' page using the pack's own template."""

    name = "template.source"

    def matches(self, *, page_type: str, subtype: str | None) -> bool:
        return page_type == "source"

    def generate(self, ctx: GenerationContext) -> str:
        from llm_wiki.ingest_raw.examples import pick_examples
        from llm_wiki.ingest_raw.llm_client import generate_text
        from llm_wiki.ingest_raw.prompts import source_page_bundle

        plan = ctx.plan
        doc = ctx.extracted
        examples = pick_examples(
            page_type="source",
            subtype=None,
            hint_keywords=[ctx.plan_entry.title],
            max_examples=1,
        )
        bundle = source_page_bundle(
            plan=plan.model_dump(mode="json"),
            classification={"edizione": plan.edizione, "source_type": plan.source_type},
            source_path=str(doc.source_path),
            outline=doc.markdown[:8000],
            examples_blocks=[e.as_prompt_block() for e in examples],
            today_iso=(ctx.today.isoformat() if ctx.today else ""),
        )
        return generate_text(messages=bundle.as_messages(), model=ctx.model)


def page_type_strategies() -> list[PageTypeStrategy]:
    """Return strategies in priority order. First ``matches`` wins."""
    return [
        # ExampleSourceStrategy(),
    ]


def extractor_strategies() -> list[Any]:
    """Domain-specific PDF extraction tweaks. Empty list = use generic backend."""
    return []


def frontmatter_defaults(*, entry: Any, plan: Any) -> dict[str, Any]:
    """Optional: pack-specific frontmatter seeded by the orchestrator."""
    return {}
