# systemd service — audit_events retention pruning.
# Schedule: settimanale (vedi .timer).
[Unit]
Description=LLM Wiki — audit_events retention prune
After=network-online.target docker.service postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=wiki
Group=wiki
WorkingDirectory=/srv/llm-wiki/app
EnvironmentFile=-/srv/llm-wiki/.env
ExecStart=/srv/llm-wiki/app/scripts/audit_retention.sh
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
