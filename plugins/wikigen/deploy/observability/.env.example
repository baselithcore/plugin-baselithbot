# Stack observability llm-wiki — esempio variabili.
# Copia in `.env` e personalizza prima di `bootstrap.sh up`.

# --- Prometheus scrape ---
# Token che Prometheus invia come X-API-Key al backend llm-wiki.
# Stesso valore deve essere in WIKI_METRICS_TOKEN del .env dell'app.
WIKI_METRICS_TOKEN=change-me-strong-random

# Target del backend per scrape /metrics.
# - docker compose: "llm-wiki:8000" (servizio sulla rete obs)
# - mac-native:     "host.docker.internal:8000"
LLM_WIKI_TARGET=host.docker.internal:8000

# --- Retention / sizing ---
PROMETHEUS_RETENTION=30d
PROMETHEUS_MAX_SIZE=10GB

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_ROOT_URL=http://localhost:3000

# --- Alertmanager (opzionali) ---
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
SLACK_WEBHOOK_URL=
ONCALL_EMAIL=
BILLING_EMAIL=
SMTP_HOST=smtp.gmail.com:587
SMTP_FROM=alerts@example.com
SMTP_USER=
SMTP_PASSWORD=
