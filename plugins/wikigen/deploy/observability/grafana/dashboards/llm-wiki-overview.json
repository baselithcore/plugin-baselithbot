{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "title": "llm-wiki — Overview",
  "tags": ["llm-wiki", "slo"],
  "timezone": "Europe/Rome",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(wiki_tenant_http_requests_total, route)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (route) (rate(wiki_tenant_http_requests_total{route=~\"$route\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Chat latency P50 / P95 / P99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(wiki_chat_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(wiki_chat_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(wiki_chat_request_latency_seconds_bucket[5m])))",
          "legendFormat": "p99 {{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Error rate (%)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (route) (rate(wiki_chat_request_errors_total[5m])) / sum by (route) (rate(wiki_chat_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "LLM calls per provider",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (provider, model, status) (rate(wiki_llm_calls_total[5m]))",
          "legendFormat": "{{provider}}/{{model}} {{status}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Retrieval / Rerank latency P95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(wiki_retrieval_latency_seconds_bucket[5m])))",
          "legendFormat": "retrieval p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(wiki_rerank_latency_seconds_bucket[5m])))",
          "legendFormat": "rerank p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "type": "stat",
      "title": "Backends up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "wiki_postgres_up", "legendFormat": "postgres" },
        { "expr": "wiki_qdrant_up", "legendFormat": "qdrant" },
        { "expr": "wiki_graphdb_up", "legendFormat": "graphdb" },
        { "expr": "wiki_llm_provider_up", "legendFormat": "llm" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ]
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    },
    {
      "type": "timeseries",
      "title": "Ingest pipeline (per-stage P95)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(wiki_ingest_stage_duration_seconds_bucket[10m])))",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 }
    }
  ]
}
