# Caddyfile — LLM Wiki production
#
# Cosa fa:
#   - HTTPS automatico (Let's Encrypt) per il dominio configurato
#   - Servire SPA Vite da /app/frontend/dist (assets immutabili 1y)
#   - Reverse proxy /api/* /auth/* /health/* a uvicorn :8000
#   - Reject diretto admin endpoints da public (loopback-only è già
#     applicato lato app, qui defense-in-depth)
#   - SSE/streaming chat: flush_interval 0, no buffer
#
# Variabili sostituibili: edita {$WIKI_DOMAIN} nel snippet base, oppure
#   esegui `caddy run --config Caddyfile --envfile /etc/caddy/.env`.
#
# Test: caddy validate --config Caddyfile

{
    # Email Let's Encrypt
    email {$ACME_EMAIL:admin@example.com}

    # Server-wide tuning
    servers {
        timeouts {
            read_body 5m
            read_header 30s
            write 5m
            idle 10m
        }
    }
}

{$WIKI_DOMAIN:wiki.example.com} {
    encode zstd gzip

    # ----- Security headers (defense-in-depth; app middleware già setta) -----
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        # CSP è settato dall'app; lasciare a Caddy di non sovrascriverlo
        -Server
    }

    # ----- Block admin from public (loopback-only also enforced app-side) ---
    @admin path /api/admin*
    handle @admin {
        respond "Not Found" 404
    }

    # ----- API + auth + health -> uvicorn -----
    @api path /api/* /auth/* /health/* /healthz
    handle @api {
        # Streaming friendly: no buffer + immediate flush per NDJSON/SSE
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
            transport http {
                read_buffer 8192
                write_buffer 8192
                response_header_timeout 5m
            }
        }
    }

    # ----- Static SPA -----
    root * /srv/llm-wiki/app/frontend/dist

    # Long cache for hashed assets (Vite produce file *-<hash>.js)
    @hashedAssets {
        path_regexp hashed \.([0-9a-f]{8,})\.(js|css|woff2?|svg|png|jpg|webp|avif|ico)$
    }
    handle @hashedAssets {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # No cache per index.html — deve sempre fetcharsi per pickup nuove versioni
    @indexHtml {
        path / /index.html
    }
    handle @indexHtml {
        header Cache-Control "no-cache, must-revalidate"
        try_files {path} /index.html
        file_server
    }

    # Default static (favicon, manifest, ecc.)
    handle {
        header Cache-Control "public, max-age=3600"
        try_files {path} /index.html
        file_server
    }

    # ----- Logging -----
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 14
            roll_keep_for 720h
        }
        format json
    }
}
