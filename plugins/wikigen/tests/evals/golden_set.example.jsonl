# Esempio golden set per evals RAG. Una riga JSON per query.
# Campi: id, question, expected_doc_ids, page_type (opzionale), notes (opzionale).
# Le righe che iniziano con # sono ignorate dal loader.
#
# expected_doc_ids = lista document_id che il retrieval DEVE includere
# nei top-K. Convenzione id pagina: "<folder>/<slug>" (es. "concepts/ferie").
# Riempi questo file con esempi reali del tuo pack prima di girare:
#   wiki-wl evals run --golden tests/evals/golden_set.example.jsonl
{"id": "q-001", "question": "Esempio: quali sono i requisiti principali del concetto X?", "expected_doc_ids": ["concepts/concetto-x"], "notes": "smoke test"}
{"id": "q-002", "question": "Esempio: come si applica la procedura Y?", "expected_doc_ids": ["sources/procedura-y", "concepts/procedura-y"], "page_type": null, "notes": "multi-doc"}
