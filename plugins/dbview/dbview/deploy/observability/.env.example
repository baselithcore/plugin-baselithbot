# Copy to .env and customize. Used by `docker compose --env-file .env up`.

# === Prometheus → dbview-api ===
# Hostname:port reachable from the prometheus container. Use "dbview-api:3001"
# when the api container is on dbview-obs-net, or "host.docker.internal:3001"
# if you run the api on the host (mac-native dev).
DBVIEW_TARGET=dbview-api:3001

# Service-to-service API key the API will accept on /api/metrics scrapes.
# MUST equal DBVIEW_API_KEY set on the api container.
DBVIEW_METRICS_TOKEN=change-me-metrics-token

# === Prometheus retention ===
PROMETHEUS_RETENTION=30d
PROMETHEUS_MAX_SIZE=10GB

# === Grafana ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_ROOT_URL=http://localhost:3000

# === Alertmanager ===
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
SLACK_WEBHOOK_URL=
ONCALL_EMAIL=
