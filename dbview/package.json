{
  "name": "dbview",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3",
    "@types/node": "^22.9.0",
    "eslint": "^9.16.0",
    "@eslint/js": "^9.16.0",
    "typescript-eslint": "^8.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "better-sqlite3",
      "esbuild",
      "@swc/core"
    ],
    "overrides": {
      "@grpc/grpc-js": "^1.14.4",
      "@opentelemetry/propagator-jaeger": "^2.9.0",
      "axios": "^1.18.0",
      "fast-uri@2": "^2.4.5",
      "fast-uri@3": "^3.1.6",
      "find-my-way": "^9.7.0",
      "form-data": "^4.0.6",
      "jsondiffpatch": "^0.7.6",
      "lodash": "^4.18.0",
      "nanoid@3": "^3.3.18",
      "protobufjs@7": "^7.6.1",
      "protobufjs@8": "^8.8.0",
      "undici@6": "^6.27.0"
    }
  }
}
