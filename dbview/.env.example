# dbview docker-compose env template
# cp .env.example .env && edit

# ---- Required ----
# Min 32 chars. Generate: openssl rand -base64 48
DBVIEW_JWT_SECRET=

# ---- Optional (defaults applied if unset) ----
LOG_LEVEL=info
LOG_FORMAT=json
APP_VERSION=dev

# Encryption key for stored connection strings (min 16 chars).
DBVIEW_SECRET=dev-secret-change-me-min-16chars

# Service-to-service key for Prometheus scrape / CI.
DBVIEW_API_KEY=

# Body / history limits.
DBVIEW_BODY_LIMIT=
DBVIEW_HISTORY_MAX=

# NL2SQL retry budget on validator rejection. Range 0..4. Default 2 → up to 3
# LLM round-trips per query. Lower for faster failure with slow local models.
DBVIEW_NL2SQL_MAX_RETRIES=

# Schema pruning thresholds for wide schemas (Salesforce Data Cloud, large
# datalakes). When the schema has more than DBVIEW_NL2SQL_PRUNE_THRESHOLD
# tables, the prompt is reduced to the top-K tables matching the user
# question (plus 1-hop FK closure for joins). Pruning is skipped when no
# token matches anything; the full schema is also restored automatically if
# the validator rejects an unknown-table reference present in the full graph.
# Defaults: 30 (threshold) / 12 (top-K seeds).
DBVIEW_NL2SQL_PRUNE_THRESHOLD=
DBVIEW_NL2SQL_PRUNE_TOPK=

# Graph (Neo4j/Ultipa) per-query timeout in ms. Range 1000..600000. Default 30000.
DBVIEW_GRAPH_QUERY_TIMEOUT_MS=

# JWT TTLs (seconds). Defaults: 900 / 2592000.
DBVIEW_JWT_ACCESS_TTL=
DBVIEW_JWT_REFRESH_TTL=

# Admin bootstrap (only used when users.json is empty).
DBVIEW_ADMIN_EMAIL=admin@dbview.local
DBVIEW_ADMIN_PASSWORD=

# Public self-signup. Default off.
DBVIEW_ALLOW_REGISTRATION=false

# ---- Observability ----
OTEL_SERVICE_NAME=dbview-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# ---- LLM providers ----
# Ollama endpoint is deployment-level: never overridable from the UI.
# Default targets the host machine; inside docker compose use
# http://ollama:11434/api (or the LLM profile alias).
OLLAMA_BASE_URL=http://localhost:11434/api

OLLAMA_MODEL_SQL=codellama:7b
OLLAMA_MODEL_GRAPH=codellama:7b
OLLAMA_MODEL_DOCUMENT=codellama:7b
OLLAMA_MODEL_KEYVALUE=codellama:7b
OLLAMA_MODEL_SEARCH=codellama:7b
OLLAMA_MODEL_VECTOR=codellama:7b
OLLAMA_MODEL_SAAS=codellama:7b
OLLAMA_MODEL_EXPLAIN=codellama:7b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_EXPLAIN=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MODEL_EXPLAIN=

# ---- DB profiles (target databases to introspect) ----
# Enable with: docker compose --profile <name> up -d
#   graph     → neo4j, falkordb
#   document  → mongo
#   keyvalue  → redis
#   search    → elasticsearch
#   vector    → qdrant
#   llm       → ollama

MONGO_USER=mongo_admin
MONGO_PASSWORD=mongo_admin_password
